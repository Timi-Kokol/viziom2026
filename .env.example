# Supabase (minigame high scores)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Contact form (Resend) — server only, never NEXT_PUBLIC_
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@viziom.si
CONTACT_FROM_EMAIL=Viziom <hello@viziom.si>

# Cal.com booking popup (public — used in the browser)
# Event URL path, e.g. username/30min — or paste the full https://cal.com/... link
NEXT_PUBLIC_CAL_LINK=

# Public site URL (no trailing slash) — used for canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://viziom.si

# Optional Google Search Console verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
